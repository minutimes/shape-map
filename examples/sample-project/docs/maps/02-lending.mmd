flowchart LR
  %% sm-map: {"kind":"user-flow","title":"책 빌리고 빌려주기","description":"빌리는 사람, 책 주인, 도서 정보 제공처, 플랫폼이 함께 움직이는 길"}
  subgraph reader["빌리는 사람"]
    reader_open(["앱 열기"])
    reader_search["읽고 싶은 책 찾기"]
    reader_available{"지금 빌릴 수 있나?"}
    reader_wait["입고 알림 신청"]
    reader_request["대여 신청하기"]
    reader_deposit["보증금 내기"]
    reader_receive["책 받기"]
    reader_return["다 읽고 돌려주기"]
    reader_refund["보증금 돌려받기"]
    reader_review(["후기 남기기"])
  end
  subgraph owner["책 주인"]
    owner_list(["책 올리기"])
    owner_check["대여 요청 확인"]
    owner_accept{"빌려줄까?"}
    owner_handover["책 건네기"]
    owner_collect["책 돌려받기"]
    owner_payout(["대여료 받기"])
  end
  subgraph catalog["도서 정보 제공처"]
    catalog_send["도서 정보 보내기"]
  end
  subgraph platform["플랫폼"]
    platform_fill["책 정보 채우기"]
    platform_match["책 주인에게 연결"]
    platform_hold["보증금 맡아 두기"]
    platform_settle["반납 확인하고 정산"]
  end

  reader_open --> reader_search
  reader_search --> reader_available
  reader_available -->|"있어요"| reader_request
  reader_available -.->|"없어요"| reader_wait
  reader_wait -.->|"알림이 오면"| reader_search
  reader_request ==>|"대여 요청"| platform_match
  platform_match ==>|"요청 전달"| owner_check
  owner_check --> owner_accept
  owner_accept ==>|"수락"| reader_deposit
  owner_accept -.->|"거절"| platform_match
  reader_deposit ==>|"보증금"| platform_hold
  platform_hold ==>|"건네도 돼요"| owner_handover
  owner_handover ==>|"책"| reader_receive
  reader_receive --> reader_return
  reader_return ==>|"책"| owner_collect
  owner_collect ==>|"반납 확인"| platform_settle
  platform_settle ==>|"대여료"| owner_payout
  platform_settle ==>|"보증금"| reader_refund
  reader_refund --> reader_review
  owner_list ==>|"ISBN"| platform_fill
  catalog_send ==>|"도서 정보"| platform_fill
  platform_fill ==>|"검색에 보이기"| reader_search

  classDef money fill:#FFF1DB,stroke:#B86E00,color:#5C3700,stroke-width:1px
  classDef data fill:#F1EAFB,stroke:#7C4DCC,color:#3F2470,stroke-width:1px
  classDef meet fill:#E3F4F1,stroke:#1F8A78,color:#0F4A40,stroke-width:1px
  classDef consumer fill:#EEF3FF,stroke:#3550C8,color:#1A2A6B,stroke-width:1px
  classDef provider fill:#FFF6E8,stroke:#9A5D00,color:#4A2D00,stroke-width:1px
  classDef operator fill:#F2F2F4,stroke:#5B5B66,color:#28282C,stroke-width:1px
  class reader_deposit,reader_refund,owner_payout,platform_hold,platform_settle money
  class catalog_send,platform_fill data
  class reader_receive,reader_return,owner_handover,owner_collect meet
  class reader consumer
  class owner,catalog provider
  class platform operator

  %% sm-block: catalog|{"summary":"책 제목, 저자, 표지 같은 정보를 보내 주는 곳이에요. 돈을 내지는 않지만 꼭 필요한 참여자예요."}
  %% sm-block: reader_deposit|{"summary":"책값의 일부를 보증금으로 맡겨요. 반납하면 돌려받아요."}
  %% sm-block: owner_handover|{"summary":"동네에서 직접 만나 건네요."}

