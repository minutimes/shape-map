  %% mlc-task: product|{"logic":"제품의 기능을 도식으로 읽고, 사람과 AI가 같은 원본에서 개선을 논의합니다.","inputs":"만드는 제품 · 남긴 의견","outputs":"함께 이해한 제품 구조 · 다음 개발 계획","ui":"큰 그림을 보고 기능을 눌러 상세 설명과 논의를 봅니다."}
  %% mlc-task: map|{"logic":"같은 기능을 계통도, 구성도, 최종 형상으로 읽습니다."}
  %% mlc-task: structure|{"logic":"기능의 소속 관계를 따라 제품 구성을 살펴봅니다.","inputs":"제품 기능과 상위 기능","outputs":"기능의 소속이 보이는 지도","ui":"카드 안의 작은 카드를 펼치고, 기능 사이의 화살표를 따라 읽습니다."}
  %% mlc-task: experience|{"logic":"기능마다 사용자가 하는 일과 받는 결과를 쉬운 말로 설명합니다.","inputs":"기능의 역할과 입출력","outputs":"이해하기 쉬운 기능 설명","ui":"최종 형상에서 사용자 경험을 중심으로 읽습니다."}
  %% mlc-task: discuss|{"logic":"기능에 남긴 생각을 다음에 바꿀 내용으로 이어갑니다."}
  %% mlc-task: comments|{"logic":"기능별로 의견, 걱정되는 점, 개선 의견을 저장합니다.","inputs":"사람이 남긴 의견","outputs":"기능에 연결된 논의","ui":"걱정이 있는 기능은 노란색으로 찾습니다."}
  %% mlc-task: proposal|{"logic":"변경 이유와 바꾼 뒤의 동작을 같은 기능에 남깁니다.","inputs":"변경 이유 · 원하는 동작","outputs":"다음 개발 변경안","ui":"수정할 기능은 빨간색으로 찾습니다."}
  %% mlc-task: timeline|{"logic":"지금의 형상을 턴으로 남기고 지난 개선을 돌아봅니다."}
  %% mlc-task: turns|{"logic":"실제로 저장한 제품 형상을 기록하고 이전 턴과 비교합니다.","inputs":"현재 지도 · 턴 이름 · 변경 설명","outputs":"다시 읽을 수 있는 형상 기록","ui":"타임라인을 옮기거나 재생해 당시 구성을 봅니다."}
  %% mlc-task: review|{"logic":"사람이 직접 확인한 기능만 검수 완료로 남깁니다.","inputs":"직접 확인한 현재 기능","outputs":"내용과 연결된 검수 기록","ui":"검수 완료는 초록색입니다. 내용이 바뀌면 다시 확인합니다."}
  %% mlc-task: source|{"logic":"원본 파일 하나를 화면과 AI가 함께 읽고 고칩니다."}
  %% mlc-task: mermaid|{"logic":"원본 파일의 변경을 열린 지도에 반영하고, 실제 Git 기록을 관련 기능과 함께 보여줍니다.","inputs":"화면 편집 · AI의 원본 수정 · 레포 코드 변경","outputs":"일치하는 지도 원본 · 기능에 연결된 코드 기록","ui":"변경 파일을 기능과 연결해 읽고, 지난 제품 형상은 턴으로 돌아봅니다."}
  %% mlc-task: brief|{"logic":"현재 지도와 남은 논의를 자연어 글로 모아 AI에게 전달할 수 있게 합니다.","inputs":"기능 설명 · 의견 · 변경안","outputs":"AI에게 건넬 논의 글","ui":"논의 글을 복사하거나 파일로 저장합니다."}
  %% mlc-proposal: brief|{"logic":"AI의 응답을 관련 기능의 의견으로 받고, 다음 변경안을 함께 정리합니다.","reason":"현재는 논의 글을 복사해 AI에게 전달합니다. 응답도 같은 기능에 연결해 이어가고 싶습니다."}
  %% mlc-task: nesting|{"logic":"큰 기능 안에 작은 기능을 여러 단계로 넣습니다. 펼치면 같은 캔버스에서 내부 구성을 읽습니다.","executor":{"kind":"code"}}
  %% mlc-task: folding|{"logic":"카드의 + 버튼으로 내부를 펼치고 − 버튼으로 접습니다. 위치와 접은 상태는 원본과 별도로 저장합니다.","executor":{"kind":"code"}}
  %% mlc-task: details|{"logic":"카드를 누르면 지도 위치를 유지하고 오른쪽에서 기능의 역할·연결·의견을 봅니다.","executor":{"kind":"code"}}
  %% mlc-task: connections|{"logic":"소속과 별도로 처리 순서·자료 전달·필요한 기능·모델 역할을 저장하고 화살표로 읽습니다.","executor":{"kind":"code"}}
  %% mlc-task: reading|{"logic":"지도에 적힌 형식과 모델 역할을 선택해 관련 기능을 강조합니다. 고유 로직과 미연결 설계를 함께 표시합니다.","executor":{"kind":"code"}}

