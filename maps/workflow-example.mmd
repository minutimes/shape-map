%% mlc-format: 1
flowchart LR
  video(["영상 제작 · 흐름 예시"])
  prepare["소재 준비"]
  sound["음성 인식"]
  index["소재 목록 확인"]
  edit["편집 초안"]
  state["영어 상태 정리"]
  choose["다음 처리 선택"]
  route["선택 결과 처리"]
  keep["현재 결과 보존"]
  retry["문제 구간 재작업"]
  owner["사용자 판단 요청"]
  review["함께 검수"]
  deliver["완성본 전달"]
  video --> prepare
  video --> edit
  video --> review
  video --> deliver
  prepare --> sound
  prepare --> index
  edit --> state
  edit --> choose
  edit --> route
  route --> keep
  route --> retry
  route --> owner
  classDef stage fill:#FFFDF7,stroke:#769585,color:#173C2D,stroke-width:1px
  classDef decision fill:#F4EFF9,stroke:#9B85B5,color:#48355C,stroke-width:1px
  classDef person fill:#FBF3E5,stroke:#B29970,color:#584B33,stroke-width:1px
  class video,prepare,sound,index,edit,state,route,keep,retry,deliver stage
  class choose decision
  class review,owner person
%% mlc-legend: stage|작업|상태와 결과가 명확한 작업
%% mlc-legend: decision|의사결정|정해진 선택지에서 처리 방향 선택
%% mlc-legend: person|함께 판단|사람이 확인하거나 결정하는 구간
%% mlc-task: video|{"logic":"소재를 준비하고 초안과 검수를 거쳐 전달합니다.","inputs":"촬영 원본 · 제작 의도","outputs":"검수한 영상","ui":"각 과정의 결과와 남은 판단을 대화로 확인합니다."}
%% mlc-workflow: video|{"mode":"sequence"}
%% mlc-task: prepare|{"logic":"소재를 식별하고 음성과 파일 정보를 함께 확인합니다.","inputs":"촬영 파일","outputs":"발화 정보 · 소재 목록","ui":"빠진 소재와 확인할 항목을 보여줍니다.","executor":{"kind":"code"}}
%% mlc-workflow: prepare|{"mode":"parallel"}
%% mlc-task: sound|{"logic":"발화와 시간 위치를 추출합니다.","inputs":"소스 오디오","outputs":"시간 정보가 있는 발화","ui":"인식이 불확실한 구간을 표시합니다.","executor":{"kind":"perception"}}
%% mlc-task: index|{"logic":"파일 존재와 길이, 식별자를 검사합니다.","inputs":"소재 파일","outputs":"검증한 소재 목록","ui":"누락되거나 읽지 못한 파일을 알려줍니다.","executor":{"kind":"code"}}
%% mlc-task: edit|{"logic":"현재 결과를 보존하면서 다음 처리 방향을 정합니다.","inputs":"소재 정보 · 현재 초안","outputs":"수정한 초안 · 확인할 구간","ui":"수정 범위와 판단이 필요한 부분을 보여줍니다."}
%% mlc-workflow: edit|{"mode":"sequence"}
%% mlc-task: state|{"logic":"수치와 분류 상태를 영어 키와 열거값으로 정리합니다.","inputs":"현재 작업 상태","outputs":"English structured state","ui":"판단에 사용할 상태를 확인할 수 있습니다.","executor":{"kind":"code"}}
%% mlc-task: choose|{"logic":"Choose KEEP, RETRY or REVIEW from the supplied state.","inputs":"English state + action options","outputs":"Action ID","ui":"선택 결과를 코드로 한국어에 대응시킵니다.","executor":{"kind":"jev","language":"en"}}
%% mlc-task: route|{"logic":"선택된 Action ID에 해당하는 처리를 수행합니다.","inputs":"KEEP · RETRY · REVIEW","outputs":"보존 · 재작업 · 판단 요청","ui":"현재 선택된 경로를 알려줍니다.","executor":{"kind":"code"}}
%% mlc-workflow: route|{"mode":"conditional"}
%% mlc-task: keep|{"logic":"현재 초안을 다음 검수 단계로 전달합니다.","inputs":"초안","outputs":"보존한 초안","ui":"바뀐 내용이 없음을 표시합니다.","condition":"Action ID = KEEP","executor":{"kind":"code"}}
%% mlc-task: retry|{"logic":"문제가 있는 범위만 다시 작업합니다.","inputs":"초안 · 문제 범위","outputs":"부분 수정안","ui":"수정 전후와 다시 확인할 구간을 보여줍니다.","condition":"Action ID = RETRY","executor":{"kind":"llm","effort":"medium"}}
%% mlc-task: owner|{"logic":"미정인 선택을 사용자에게 확인합니다.","inputs":"초안 · 선택지","outputs":"사용자 결정","ui":"판단이 필요한 구간과 선택지를 제시합니다.","condition":"Action ID = REVIEW","executor":{"kind":"human"}}
%% mlc-task: review|{"logic":"사용자가 결과를 재생하고 수정할 구간을 지정합니다.","inputs":"편집 초안","outputs":"승인 또는 구간별 수정 의견","ui":"확인할 구간과 비교 결과를 대화로 보여줍니다.","executor":{"kind":"human"}}
%% mlc-task: deliver|{"logic":"승인된 결과의 저장 위치와 파일을 확인합니다.","inputs":"승인된 영상","outputs":"전달할 파일과 위치","ui":"실제로 확인된 저장 위치를 알려줍니다.","executor":{"kind":"code"}}
